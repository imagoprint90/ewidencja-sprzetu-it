# Skopiuj ten plik do .env.local i uzupełnij wartościami z panelu Supabase
# (Project Settings -> API Keys). Nigdy nie commituj pliku .env.local do repozytorium
# (jest już wykluczony w .gitignore).

# Adres URL Twojego projektu Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" (dawniej "anon public") — bezpieczny do użycia w przeglądarce,
# dostęp ograniczają reguły RLS w bazie danych.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "Secret key" (dawniej "service_role") — WYŁĄCZNIE do użytku po stronie serwera (np.
# w Route Handlers generujących PDF). Nigdy nie dodawaj prefiksu NEXT_PUBLIC_ do tej
# zmiennej i nigdy nie używaj jej w kodzie działającym w przeglądarce.
SUPABASE_SERVICE_ROLE_KEY=

# Wysyłka maili w zakładce Powiadomienia (opcjonalne — bez tych zmiennych wysyłka zwraca
# czytelny błąd zamiast się wywalać). Dane logowania do Twojej skrzynki SMTP — patrz
# README.md, sekcja "Konfiguracja wysyłki maili" (jak je znaleźć dla Gmail/Outlook/hostingu).
# WYŁĄCZNIE do użytku po stronie serwera.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Adres nadawcy, np. "Ewidencja IT <powiadomienia@twojafirma.pl>" — zwykle to samo co SMTP_USER.
SMTP_FROM_EMAIL=

# Ustaw na "true" tylko jeśli dostawca wymaga tego jawnie mimo portu innego niż 465
# (w normalnym przypadku nie trzeba tego ustawiać — port 465 = szyfrowanie od razu (SSL/TLS)
# jest wykrywane automatycznie, inne porty jak 587 używają STARTTLS).
SMTP_SECURE=

# Automatyczne harmonogramy powiadomień (zakładka Powiadomienia -> Automatyczne) — dowolny
# długi, losowy ciąg znaków. Vercel sam dołącza go jako nagłówek Authorization przy
# wywoływaniu zadania cron, więc endpoint /api/cron/notification-schedules może sprawdzić,
# że żądanie naprawdę przyszło od Vercel, a nie od kogoś z zewnątrz. Wymagane, żeby
# harmonogramy w ogóle działały — bez tego endpoint cron zawsze odrzuca żądanie.
CRON_SECRET=
