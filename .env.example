# Skopiuj ten plik do .env.local i uzupełnij wartościami z panelu Supabase
# (Project Settings -> API Keys). Nigdy nie commituj pliku .env.local do repozytorium
# (jest już wykluczony w .gitignore).

# Adres URL Twojego projektu Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" (dawniej "anon public") — bezpieczny do użycia w przeglądarce,
# dostęp ograniczają reguły RLS w bazie danych.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "Secret key" (dawniej "service_role") — WYŁĄCZNIE do użytku po stronie serwera (np.
# w Route Handlers generujących PDF). Nigdy nie dodawaj prefiksu NEXT_PUBLIC_ do tej
# zmiennej i nigdy nie używaj jej w kodzie działającym w przeglądarce.
SUPABASE_SERVICE_ROLE_KEY=

# Wysyłka maili w zakładce Powiadomienia (opcjonalne — bez tych dwóch zmiennych wysyłka
# zwraca czytelny błąd zamiast się wywalać). Klucz API z panelu resend.com (Dashboard ->
# API Keys) — WYŁĄCZNIE do użytku po stronie serwera.
RESEND_API_KEY=

# Adres nadawcy z domeny zweryfikowanej w Resend, np. "Ewidencja IT <powiadomienia@twojafirma.pl>".
RESEND_FROM_EMAIL=
